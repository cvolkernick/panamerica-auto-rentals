# Cloudflare Pages headers. Replaces next.config.ts headers(), which
# `output: "export"` cannot emit.
/plans/*.pdf
  Content-Type: application/pdf
  X-Content-Type-Options: nosniff

/owner/
  X-Robots-Tag: noindex

/owner/*
  X-Robots-Tag: noindex

/manager/
  X-Robots-Tag: noindex

/manager/*
  X-Robots-Tag: noindex

/admin/
  X-Robots-Tag: noindex

/admin/*
  X-Robots-Tag: noindex

/sign-in/
  X-Robots-Tag: noindex

/sign-in/*
  X-Robots-Tag: noindex

/api/portal/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff

# Installable app. sw.js must never be cached long, or updates (and the
# kill switch in docs/pwa.md) would not reach installed clients.
/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
