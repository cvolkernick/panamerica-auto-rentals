# Cloudflare Pages headers. Replaces next.config.ts headers(), which
# `output: "export"` cannot emit.
/plans/*.pdf
  Content-Type: application/pdf
  X-Content-Type-Options: nosniff

/owner/
  X-Robots-Tag: noindex

/owner/*
  X-Robots-Tag: noindex

/admin/
  X-Robots-Tag: noindex

/admin/*
  X-Robots-Tag: noindex

/api/portal/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
