# Do not put a password, hash, pepper, or setup token in this file.
# ADMIN_EMAILS=
PORTAL_DEV_AUTH=0
# PORTAL_DEV_EMAIL=
# PORTAL_SETUP_TOKEN=
# PORTAL_PEPPER=
